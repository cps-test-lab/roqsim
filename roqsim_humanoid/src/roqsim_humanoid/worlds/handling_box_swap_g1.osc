# Scene 4: scene 3's box swap by a humanoid robot (handling_box_swap_g1.yaml), its stand-offs the robot's.
import osc.roqsim

scenario box_swap_g1:
    do serial:
        zone_entered(zone: 'drawer_zone', pattern: 'tote_*')
        # pulled out to its stop in five strokes, stepping back between
        humanoid_approach(humanoid: 'g1', target: 'cell/drawer_1/grip', standoff: 0.5)
        humanoid_grasp(humanoid: 'g1', hand: 'right', target: 'cell/drawer_1/grip')
        humanoid_pull(humanoid: 'g1', hand: 'right', distance: 0.09)
        humanoid_release(humanoid: 'g1', hand: 'right')
