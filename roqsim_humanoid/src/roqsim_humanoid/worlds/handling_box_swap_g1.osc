        humanoid_place(humanoid: 'g1', at: 'cell/drawer_1/inside')
        # pushed shut in five strokes, stepping up between
        humanoid_approach(humanoid: 'g1', target: 'cell/drawer_1/grip', standoff: 0.5)
        humanoid_grasp(humanoid: 'g1', hand: 'right', target: 'cell/drawer_1/grip')
        humanoid_push(humanoid: 'g1', hand: 'right', distance: 0.09)
