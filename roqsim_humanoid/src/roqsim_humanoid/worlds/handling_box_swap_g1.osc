        humanoid_approach(humanoid: 'g1', target: 'tote_full', standoff: 0.3)
        humanoid_grasp(humanoid: 'g1', hand: 'both', target: 'tote_full')
        humanoid_carry(humanoid: 'g1', to: 'trolley', standoff: 0.9)
