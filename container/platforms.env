# Which architectures each roqsim image is built for.
#
# One source of truth, sourced by container/build.sh and read by .github/workflows/image.yml,
# so a local build and a CI build cannot disagree about what an image is. Stating it in both
# places is how they drift.
#
# A platform listed here is a claim about the BASE image, not a wish. Asking buildx for an
# architecture the base does not publish does not fail: the build takes the base's only
# architecture, labels it with the one that was asked for, and pushes an image that dies with
# "Invalid ELF image for this architecture" the first time anything execs inside it -- at run
# time, on someone else's machine, long after a green build. So each line records the base
# that permits it:
#
#   roqsim       python:${PYTHON_VERSION}-slim -- a multi-arch index (amd64, arm64, and more).
#                Its wheels follow: mujoco and opencv-python-headless both publish
#                manylinux aarch64, and the optional torch extra has a linux aarch64 CPU wheel.
#   roqsim-ros   ros:${ROS_DISTRO}-ros-base -- the Docker official ROS image, published for
#                amd64 and arm64, and every ros-${ROS_DISTRO}-* deb the image installs exists
#                in the arm64 suite (arm64 is a tier-1 platform for Jazzy on Ubuntu Noble).
#                This is NOT osrf/ros:${ROS_DISTRO}-desktop-full, whose tag is a single amd64
#                manifest rather than an index; anything moving to that base has to narrow
#                these lines to linux/amd64 to match.
#
# Adding an architecture is one edit here plus its RUNNER_ line below, and `make check` fails
# if a platform has no runner mapped -- an unmapped architecture would otherwise be dropped
# from the matrix silently, which reads as "built everywhere" while building one thing less.

PLATFORMS_ROQSIM=linux/amd64,linux/arm64
PLATFORMS_ROQSIM_ROS=linux/amd64,linux/arm64

# The GitHub-hosted runner that is NATIVE to each platform above, named RUNNER_<platform> with
# `/` and `-` folded to `_`. Native per architecture, one job each, merged into one manifest --
# rather than one job emulating the others under QEMU -- for two reasons, in this order:
#
#   1. A native build cannot mislabel. There is no second architecture present to label
#      wrongly, so the failure mode described above is structurally impossible rather than
#      merely watched for. The workflow installs no emulator at all; if one is ever needed
#      here, a native runner went missing and that is the thing to fix.
#   2. It is far faster than emulating a colcon build and an apt install of MoveIt.
#
# Both labels are GitHub-hosted and free for a public repository, which this is.
RUNNER_linux_amd64=ubuntu-latest
RUNNER_linux_arm64=ubuntu-24.04-arm
