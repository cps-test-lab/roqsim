<!-- A rack with one slot stated as sites, the convention a prop or the slots component writes:
     its place frame rack/bin_0 on the rack's top, and two stances, one on each side it is worked
     from (test_slots.py). -->
<mujoco model="slot_rack">
  <worldbody>
    <light name="sun" directional="true" pos="0 0 8" dir="0 0.2 -1"/>
    <geom name="floor" type="plane" size="8 8 0.05"/>
    <body name="rack" pos="2 0 0">
      <geom name="rack_top" type="box" pos="0 0 0.45" size="0.3 0.6 0.45"/>
      <site name="rack/bin_0" pos="-0.05 0.25 0.9"/>
      <site name="rack/bin_0/stand_0" pos="-0.6 0.25 0" euler="0 0 0"/>
      <site name="rack/bin_0/stand_1" pos="-0.05 1.1 0" euler="0 0 -90"/>
      <!-- a slot that is where to stand alone: no hand target, a stance -->
      <site name="rack/side/stand" pos="0.0 -1.3 0" euler="0 0 90"/>
    </body>
  </worldbody>
  <compiler angle="degree"/>
</mujoco>
