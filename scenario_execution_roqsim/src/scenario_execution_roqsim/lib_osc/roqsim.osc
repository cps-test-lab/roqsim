# The roqsim substrate's OpenSCENARIO vocabulary: what a scenario can ask a running roqsim simulation, and
# what it can break in one. `import osc.roqsim`.
#
# Every action here works in BOTH shapes -- a stepped in-process run (scenario-execution's own runner
# with `--simulation`) and a simulator in another process (`roqsim sim`, under the ROS runner or any
# other), reached over the control socket it serves. The transport is chosen from what the runner
# offers, not declared here, so a scenario moves between the two unedited. None of them can run under
# `remote()`: a remote server is handed no simulation.

import osc.types  # pose_3d / velocity_6d, for set_entity_state

# How a displacement is reduced to one number.
#
# `distance` and `planar` are MAGNITUDES (planar ignores z, which is what a driving robot wants).
# `x`/`y`/`z` are SIGNED, and the sign of `threshold` is what says which way -- `threshold: 0.05,
# mode: z` means risen 5 cm, `threshold: -0.05` means fallen 5 cm. Read that twice before writing
# `mode: z` expecting |dz|; a campaign sweeping [-0.05, 0.05] on an axis mode is sweeping two
# different QUESTIONS, not two levels of one factor.
enum displacement_mode: [ distance, planar, x, y, z ]

# How a list of entities is quantified. `all` because that is how the rest of the vocabulary reads a
# list (`wait_for_topics(topics: [...])` waits for all of them); `any` is a genuinely different
# instrument -- "did anything on this table get knocked over".
enum entity_quantifier: [ all, any ]

action entity_moved:
    # Succeed once the named entities have been DISPLACED from where they were when this action
    # started. Net displacement, NOT path length: an entity that goes out and comes back has moved
    # zero. (`osc.ros`'s odometry_distance_traveled integrates a path instead, and reports a larger
    # number on any curve.) The baseline is taken on this action's first tick, so "since when" is the
    # point in the scenario where it sits.
    #
    # Over the control socket the pose is a round-trip, so a crossing is resolved at the tick period
    # rather than at the physics step; a dwell shorter than one tick means "the first tick past it" either way.
    entities: list of string                          # roqsim entity names -- the world's `name:`, not a
                                                      # body or a TF frame. One object is a 1-element
                                                      # list; OSC has no union type.
    threshold: float                                  # metres. SIGNED for x/y/z (see displacement_mode)
    mode: displacement_mode = displacement_mode!distance
    dwell: float = 0.0                                # seconds of SIM time the condition must hold,
                                                      # continuously. 0 = fire on the crossing.
    require: entity_quantifier = entity_quantifier!all

action entity_rotated:
    # As entity_moved, for orientation: the geodesic angle between the entity's current orientation
    # and the one it had when this action started -- the single rotation that takes one to the other,
    # whatever axis it is about. A separate action so that `angle` names its own unit; sharing
    # entity_moved's `threshold` would make one parameter mean metres or radians depending on a
    # sibling argument.
    entities: list of string
    angle: float                                      # radians, magnitude, 0 < angle <= pi
    dwell: float = 0.0
    require: entity_quantifier = entity_quantifier!all

action entity_monitor:
    # Keep a scenario variable equal to a value a PLUGIN publishes about an entity, every tick -- the
    # simulator's counterpart of `osc.ros`'s `topic_monitor`. The condition is then plain
    # OpenSCENARIO over the variable, so a scenario reads a trial's outcome and ends a run on it:
    #
    #     var tripped: bool = false
    #     do parallel:
    #         entity_monitor(entity: 'ur5e', value: 'force_limit.tripped', target_variable: tripped)
    #         serial:
    #             wait tripped == true
    #             emit end
    #
    # A report is an endpoint the plugin declares on the entity it watches (`force_limit`, `contact`,
    # `clearance`, a trial plugin's own), addressed as the world names it -- never as a topic. `value`
    # is '<report>.<field>'; a bare '<report>' means the field its ROS publication carries
    # (`force_limit` -> `tripped`). Every field of a report is readable on both transports.
    #
    # It never succeeds: put it in a `parallel` branch beside the ones that decide, as any monitor.
    # Until the first reading arrives the variable keeps its declared default, so declare one the
    # condition does not hold for. A name that does not exist, and a field that is not a single
    # number, flag or string, are refused with the same text in-process and over the socket.
    entity: string                                    # the entity that owns the report -- the world's
                                                      # `name:` for it
    value: string                                     # '<report>.<field>', or '<report>' for the
                                                      # field it publishes
    target_variable: string                           # the variable to keep current, e.g. `tripped`

action entity_navigate:
    # Send an entity somewhere, and succeed when it gets there. The mover is the SIMULATOR's -- a
    # `navigator` component on that entity plans and drives it internally -- so this drives the
    # traffic in a trial, never the robot under test. Contrast `osc.nav2`'s `nav_to_pose`, which
    # commands an EXTERNAL nav2 stack over ROS: that one is the subject, this one is the apparatus.
    # They stay separate actions because they prove different things -- a goal reached through nav2
    # says something about nav2; a goal reached through this says the traffic arrived on cue.
    #
    # POSITIONS only: the navigator drives to a point and stops facing the way it arrived, so a
    # nonzero orientation is REFUSED rather than accepted and dropped. A final heading is a
    # capability to add to the navigator, not a value to pass and ignore.
    # The route replaces whatever the navigator was doing, and the entity's own configured route
    # resumes when it finishes, if it had one. A branch that is abandoned cancels the route rather
    # than leaving the mover driving to a goal the scenario has given up on.
    #
    entity: string                        # roqsim entity name -- the world's `name:`, not a body
                                          #   and not a TF frame
    goal_poses: list of pose_3d           # world-frame. One goal is a 1-element list; OSC has no
                                          #   union type, the same rule the rest of this file follows
    success_on_acceptance: bool = false   # true -> succeed once the route is accepted, without
                                          #   waiting for arrival (fire-and-forget traffic)

action entity_navigate_start:
    # Run the route the entity was CONFIGURED with, and succeed when it finishes.
    #
    # A separate action rather than `entity_navigate` with an empty list, because a list parameter
    # cannot carry a default in this grammar -- and because the distinction is worth a name. With
    # the route in the world (`navigator: {goals: [...], autostart: false}`) and only the trigger
    # here, the trajectory is part of the world's provenance -- identical in every repetition, and
    # visible in a campaign's config diff -- while its timing belongs to the trial. Sending the
    # route from the scenario instead puts both in the scenario. Both are legitimate; they answer
    # different questions.
    #
    # An entity with no configured route is refused rather than reported as arrived. Stopping it
    # early is the scenario's, as for any action: `until`, `one_of` or `timeout` cancel the route.
    entity: string
    success_on_acceptance: bool = false

action spawn_entity:
    # Make an entity the world DECLARED perceivable, at the pose it appears at. Activation, not
    # creation: roqsim never recompiles the model, so a name the world does not carry is refused --
    # which is also why there is no `uri` here. The pose is applied in the same transaction as the
    # presence flip, so the entity is never perceivable at a pose nobody asked for; a `pose_3d`,
    # read by the parser a world document and simulation_interfaces both use.
    #
    # This is the verb for a per-RUN start pose. Fails the trial when the spawn does not land.
    #
    # `scenario_execution_sim` declares one of these too. An action name is unique within a
    # LIBRARY: an invocation binds to the implementation from the package whose library declared
    # it, so importing `osc.roqsim` is what selects this one.
    entity: string                                    # roqsim entity name -- the world's `name:`
    pose: pose_3d

action delete_entity:
    # Make an entity the world declared ABSENT, where it is: no sensor sees it, nothing touches it,
    # and the control plane stops listing it. Absence, not removal -- roqsim never recompiles the
    # model -- so the pose is kept and a later `spawn_entity` brings it back. `spawn_entity` run the
    # other way, which is why it takes no pose.
    #
    # Fails the trial when the delete does not land, including for an entity already absent.
    #
    # `scenario_execution_sim` declares one of these too; importing `osc.roqsim` selects this one.
    entity: string                                    # roqsim entity name -- the world's `name:`

action set_entity_state:
    # Put a free-jointed entity in a state: at `pose`, moving at `twist`. The name and shape are
    # `simulation_interfaces`' SetEntityState, because it is the same operation -- and `twist`
    # defaults to zero, so a placement that states none behaves as a fresh spawn does. The
    # counterpart of `spawn_robot.pos`/`.yaw` for a factor that is decided per RUN (a campaign's
    # randomly generated start pose) rather than per CONFIGURATION -- nothing before compile knows a
    # value drawn once per repetition, and the substrate does not recompile mid-run. A FULL pose:
    # `orientation` takes roll/pitch/yaw or a quaternion, read by the same parser a world document
    # and `simulation_interfaces/SetEntityState` go through, so one orientation means one thing
    # everywhere. What a body cannot take, the simulator refuses (see below).
    #
    # Fails the trial when the write does not land (the simulator refused it: the entity has neither
    # a free joint nor a mocap body) -- a teleport that did not happen must not leave a row whose recorded start_pose the
    # robot's body never reached.
    entity: string                                    # roqsim entity name -- the world's `name:`, not
                                                      # a body or a TF frame
    pose: pose_3d
    twist: velocity_6d = velocity_6d()                # zero unless stated

action entity_call:
    # Send any command a world's plugins declare, and fail the trial when it did not land. A fault
    # switched on (a `model_override`'s `override`, a sensor `fault:` block's `override`), a tare, a
    # gripper -- addressed as the world names it: the entity that owns the command (the world's
    # `name:`) or the component that declares it ('robot.lidar'), and the command's name. `command`
    # may also carry the component's path ('force_torque/tare'). `roqsim endpoints` lists a running
    # world's. (The parameter is not called `call`: that is an OpenSCENARIO keyword.)
    #
    #     entity_call(entity: 'ur5e', command: 'force_torque/tare')
    #     entity_call(entity: 'grip_fault', command: 'override', value: 'true', require_verified: true)
    #
    # The WORLD owns what the command does and how much (a fault's `to:`, a sensor's `fault:`
    # values), so severity stays a campaign factor; this owns only WHEN. Restoring a fault is the
    # same call with value 'false', so a transient fault is two calls with a `wait` between them.
    #
    # Where the command names an endpoint that confirms it, the outcome carries that verdict,
    # recorded in the step that applied it, and `require_verified` fails the trial on 'no_effect' --
    # a row that claims a fault which never happened -- and on a confirmation that could not be read
    # (a paused simulator). 'untested' (nothing to verify, a restore) passes. A command the producer
    # refuses, or one with no outcome in time, fails with the producer's own text.
    entity: string                                    # the owning entity, or the declaring component
    command: string                                   # the command's name, e.g. 'override'
    value: string = ''                                # JSON: 'true', '{"vx": 0.2}'; empty = none
    require_verified: bool = true                     # fail on 'no_effect' or no confirmation
