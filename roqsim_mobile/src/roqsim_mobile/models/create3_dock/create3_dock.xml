<mujoco model="create3_dock">
  <!--
    The iRobot Create 3 charging dock (irobot_create_description/urdf/dock/standard_dock.urdf.xacro
    @ 1fccb76), the prop a TurtleBot 4 docks to. A static body: the reference description spawns it
    static, and nothing moves a dock.

    Collision is the reference's single box over the raised back of the dock; the plate the robot
    drives onto is visual only there too, so the base rolls over it as it does in the reference
    simulator. The infrared emitters are sites at the reference's poses (URDF z + the 4.6 mm
    z_offset of its visual): the omnidirectional `halo_link` a robot's IR receiver ranges the dock
    by, and the three buoys the reference's visualisation draws. What the emitters mean -- an
    opcode, a docked verdict -- is a stack's business over the sites' ground-truth poses.

    The visual is the reference's Collada mesh, converted exactly and decimated to 4000 triangles;
    its two materials (black housing, white top) are flattened to one.
  -->
  <compiler meshdir="meshes"/>

  <asset>
    <material name="dock_dark" rgba="0.12 0.12 0.13 1"/>
    <mesh name="dock_visual" file="dock_visual.obj"/>
  </asset>

  <worldbody>
    <body name="std_dock_link">
      <geom name="dock_visual" type="mesh" mesh="dock_visual" material="dock_dark" pos="0 0 0.0046"
            contype="0" conaffinity="0" group="2"/>
      <geom name="dock_collision" type="box" size="0.02 0.065 0.05" pos="-0.045 0 0.05" group="3"
            rgba="0.3 0.3 0.3 0.3"/>
      <!-- IR emitters: the halo (360 deg, 0.6096 m) and the three buoys (30 deg apertures at
           +/-10 deg for green/red, 10 deg straight out for yellow), facing +x. -->
      <site name="halo_link"        pos="-0.06 0 0.0904" size="0.004" rgba="1 0 0 0"/>
      <site name="green_buoy_link"  pos="-0.06 0 0.0604" quat="0.996195 0 0 -0.087156" size="0.004" rgba="0 1 0 0"/>
      <site name="red_buoy_link"    pos="-0.06 0 0.0604" quat="0.996195 0 0  0.087156" size="0.004" rgba="1 0 0 0"/>
      <site name="yellow_buoy_link" pos="-0.06 0 0.0604" size="0.004" rgba="1 1 0 0"/>
    </body>
  </worldbody>
</mujoco>
