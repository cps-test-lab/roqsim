          <inertial pos="0 0 0" mass="1.2" diaginertia="0.11042056 0.11042056 0.11042056"/>
          <geom class="visual" mesh="SICK-S300__m0" material="SICK-S300__m0_mat" pos="0 0 -0.12" quat="0.0005633122 -0.0005628638 -0.706825 0.707388"/>
