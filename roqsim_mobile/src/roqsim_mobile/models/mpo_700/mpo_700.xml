          <geom class="visual" mesh="SICK-S300__m5" material="SICK-S300__m5_mat" pos="0 0 -0.12" quat="0.0005633122 -0.0005628638 -0.706825 0.707388"/>
          <geom class="visual" mesh="SICK-S300__m6" material="SICK-S300__m6_mat" pos="0 0 -0.12" quat="0.0005633122 -0.0005628638 -0.706825 0.707388"/>
          <geom class="collision" mesh="SICK-S300__m0" name="lidar_2_link_collision" pos="0 0 -0.12" quat="0.0005633122 -0.0005628638 -0.706825 0.707388"/>
        </body>
        <body name="mpo_700_caster_front_left_link" pos="0.24 0.18 0.22">
