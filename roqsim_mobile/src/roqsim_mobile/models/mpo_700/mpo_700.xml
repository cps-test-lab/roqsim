          <geom class="visual" mesh="SICK-S300__m1" material="SICK-S300__m1_mat" pos="0 0 -0.12" quat="0.0005633122 -0.0005628638 -0.706825 0.707388"/>
          <geom class="visual" mesh="SICK-S300__m2" material="SICK-S300__m2_mat" pos="0 0 -0.12" quat="0.0005633122 -0.0005628638 -0.706825 0.707388"/>
