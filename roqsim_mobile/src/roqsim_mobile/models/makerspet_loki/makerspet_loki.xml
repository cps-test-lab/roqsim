            <geom class="visual" type="sphere" size="0.02" material="makerspet_loki_white" pos="0 0 0"/>
            <geom class="caster_collision" type="sphere" size="0.02" name="caster_link_collision0" pos="0 0 0"/>
          </body>
          <body name="wheel_left_link" pos="0 0.0795315 0.015500000000000003" quat="0.7071068 -0.7071068 0 0">
            <inertial pos="0 0 0" mass="0.05" diaginertia="1.753229166666667e-05 1.753229166666667e-05 2.8056250000000008e-05"/>
            <joint name="wheel_left_joint" class="wheel"/>
            <geom class="visual" type="cylinder" size="0.0335 0.0145" material="makerspet_loki_blue" pos="0 0 0"/>
            <geom class="collision" type="cylinder" size="0.0335 0.0145" name="wheel_left_link_collision0" pos="0 0 0"/>
          </body>
          <body name="wheel_right_link" pos="0 -0.0795315 0.015500000000000003" quat="0.7071068 -0.7071068 0 0">
            <inertial pos="0 0 0" mass="0.05" diaginertia="1.753229166666667e-05 1.753229166666667e-05 2.8056250000000008e-05"/>
            <joint name="wheel_right_joint" class="wheel"/>
            <geom class="visual" type="cylinder" size="0.0335 0.0145" material="makerspet_loki_blue" pos="0 0 0"/>
            <geom class="collision" type="cylinder" size="0.0335 0.0145" name="wheel_right_link_collision0" pos="0 0 0"/>
          </body>
          <body name="base_scan" pos="0 0 0.13135" quat="6.123234e-17 -1 0 0">
            <inertial pos="0 0 0" mass="0.2" diaginertia="5.8780166666666684e-05 5.8780166666666684e-05 0.00010758400000000002"/>
