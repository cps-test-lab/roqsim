            <body name="head_link" pos="0 0 0.003">
              <inertial pos="0 0 0" mass="0.2" diaginertia="0.00037048819999999994 0.00037048819999999994 0.0004169763999999999"/>
              <geom class="visual" type="mesh" mesh="head" material="makerspet_loki_red" pos="0 0 0"/>
              <geom class="collision" type="cylinder" size="0.1021 0.045" name="head_link_collision0" pos="0 0 0.045"/>
              <body name="tablet_link" pos="0.03209999999999999 0 0" quat="0.9848077 0 -0.1736483 0">
                <inertial pos="0 0 0" mass="0.2" diaginertia="0.00010301016666666668 0.0004656101666666666 0.0005659203333333333"/>
                <geom class="visual" type="box" size="0.08345 0.03905 0.0045" material="makerspet_loki_dark" pos="0 0 0.03905" quat="0.5 0.5 0.5 0.5"/>
                <geom class="collision" type="box" size="0.08345 0.03905 0.0045" name="tablet_link_collision0" pos="0 0 0.03905" quat="0.5 0.5 0.5 0.5"/>
                <body name="color_camera_link" pos="0.004399999999999999 -0.07544999999999999 0.03905">
                  <geom class="visual" type="cylinder" size="0.002 5e-05" material="makerspet_loki_white" pos="0 0 0" quat="0.7071068 0 0.7071068 0"/>
                </body>
                <body name="imu_link" pos="0 0 0.03905">
