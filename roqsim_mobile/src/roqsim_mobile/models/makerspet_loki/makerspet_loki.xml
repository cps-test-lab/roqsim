        <geom class="visual" type="cylinder" size="0.1021 0.06135" material="makerspet_loki_white" pos="0 0 0.06135"/>
        <geom class="collision" type="cylinder" size="0.1021 0.06135" name="base_link_collision0" pos="0 0 0.06135"/>
          <body name="caster_link" pos="0.0635 0 0.0020000000000000018">
