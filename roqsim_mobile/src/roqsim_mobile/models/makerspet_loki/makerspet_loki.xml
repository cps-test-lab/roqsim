            <geom class="collision" type="cylinder" size="0.0328 0.00865" name="base_scan_collision0" pos="0 0 0"/>
          </body>
          <body name="base_upper_link" pos="0 0 0.1422">
            <inertial pos="0 0 0" mass="0.1" diaginertia="0.00026068525 0.00026068525 0.0005212205"/>
            <geom class="visual" type="cylinder" size="0.1021 0.0015" material="makerspet_loki_white" pos="0 0 0.0015"/>
