<mujoco model="tricycle_agv">
  <!--
    A three-wheel AGV (a small tugger or pallet-truck-like base) for testing the tricycle_drive
    plugin on a complete vehicle: tests/test_tricycle_agv_scene.py spawns it by path and states its
    drive and scanner components there, since a test fixture has no manifest. It is no product:
    every value below is marked ASSUMPTION, and all geometry is primitives.

    Layout: one steered, driven front wheel at x = 0.60 on the centre line (tricycle_drive's
    `drive: steer_wheel`, `steer_offset: 0.60`) and two passive wheels on a fixed rear axle through
    base_link, which is on the floor. It cannot turn in place.

    Tyre collision geoms are ELLIPSOIDS with the tyre's radius and half-width. A cylinder lying on a
    plane touches it at both rim edges; on a curve those edges want different speeds, one rigid
    rolling joint forces one, and the tyre slides until the curve and the odometry are both off. An
    ellipsoid touches at one point.
  -->
  <compiler angle="radian" autolimits="true"/>

  <default>
    <default class="tricycle_agv">
      <default class="visual">
        <geom contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom group="3" rgba="0.6 0.1 0.1 0.35"/>
      </default>
      <!-- See the header for why tyres are ellipsoids. -->
      <default class="tyre">
        <geom type="ellipsoid" group="3" rgba="0.1 0.1 0.1 0.4" friction="1.0 0.005 0.0001"/>
      </default>
    </default>
  </default>

  <asset>
    <material name="mat_tricycle_agv_body" rgba="0.95 0.62 0.10 1"/>
    <material name="mat_tricycle_agv_deck" rgba="0.20 0.20 0.22 1"/>
    <material name="mat_tricycle_agv_tyre" rgba="0.08 0.08 0.08 1"/>
    <material name="mat_tricycle_agv_hub" rgba="0.70 0.70 0.72 1"/>
  </asset>

  <worldbody>
    <body name="base_link" childclass="tricycle_agv">
      <freejoint name="base_free"/>
      <site name="base_imu" pos="0 0 0.28" size="0.005" rgba="0 0 0 0"/>
      <!-- Chassis: x -0.15 .. 0.75, |y| <= 0.28, z 0.20 .. 0.36. ASSUMPTION: a 0.90 x 0.56 m body
           above every wheel, so no tyre touches it at any steering angle. Its mass sets the
           inertia (MuJoCo derives it from the box). ASSUMPTION: 60 kg. -->
      <geom class="collision" name="chassis_geom" type="box" pos="0.30 0 0.28"
            size="0.45 0.28 0.08" mass="60"/>
      <geom class="visual" type="box" pos="0.30 0 0.28" size="0.45 0.28 0.08"
            material="mat_tricycle_agv_body"/>
      <geom class="visual" type="box" pos="0.30 0 0.365" size="0.44 0.27 0.005"
            material="mat_tricycle_agv_deck"/>

      <!-- Fixed rear axle, through base_link. ASSUMPTION: r = 0.075 m, 0.04 m wide, track 0.44 m.
           Passive here: nothing drives them, and tricycle_drive publishes them as passive_joints. -->
      <body name="rear_left_wheel" pos="0 0.22 0.075">
        <joint name="rear_left_wheel_joint" axis="0 1 0" damping="0.02" armature="0.005"/>
        <geom class="tyre" name="rear_left_wheel_geom" size="0.075 0.02 0.075" mass="2"/>
        <geom class="visual" type="cylinder" size="0.075 0.02" quat="0.7071068 0.7071068 0 0"
              material="mat_tricycle_agv_tyre"/>
        <geom class="visual" type="cylinder" size="0.04 0.021" quat="0.7071068 0.7071068 0 0"
              material="mat_tricycle_agv_hub"/>
      </body>
      <body name="rear_right_wheel" pos="0 -0.22 0.075">
        <joint name="rear_right_wheel_joint" axis="0 1 0" damping="0.02" armature="0.005"/>
        <geom class="tyre" name="rear_right_wheel_geom" size="0.075 0.02 0.075" mass="2"/>
        <geom class="visual" type="cylinder" size="0.075 0.02" quat="0.7071068 0.7071068 0 0"
              material="mat_tricycle_agv_tyre"/>
        <geom class="visual" type="cylinder" size="0.04 0.021" quat="0.7071068 0.7071068 0 0"
              material="mat_tricycle_agv_hub"/>
      </body>

      <!-- The steered, driven front wheel. ASSUMPTION: wheelbase 0.60 m (= steer_offset), r = 0.09
           m, 0.06 m wide, lock +-1.3 rad. The lock makes the physical minimum turning radius about
           base_link 0.60 / tan(1.3) = 0.167 m. The steering is damped so the wheel holds its angle
           when the vehicle stops, as a real steering unit does. -->
      <body name="steer_link" pos="0.60 0 0.09">
        <joint name="steer_joint" axis="0 0 1" range="-1.3 1.3" damping="2" armature="0.05"/>
        <geom class="visual" type="box" pos="0 0 0.07" size="0.05 0.05 0.03" mass="1"
              material="mat_tricycle_agv_hub"/>
        <body name="front_wheel">
          <joint name="front_wheel_joint" axis="0 1 0" damping="0.05" armature="0.01"/>
          <geom class="tyre" name="front_wheel_geom" size="0.09 0.03 0.09" mass="3"/>
          <geom class="visual" type="cylinder" size="0.09 0.03" quat="0.7071068 0.7071068 0 0"
                material="mat_tricycle_agv_tyre"/>
          <geom class="visual" type="cylinder" size="0.05 0.031" quat="0.7071068 0.7071068 0 0"
                material="mat_tricycle_agv_hub"/>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <!-- MuJoCo excludes contacts only between a body and its direct parent; the front wheel is two
         bodies below the chassis, through the steering link. -->
    <exclude body1="base_link" body2="front_wheel"/>
  </contact>

  <actuator>
    <!-- Steering: a POSITION servo on the vertical axis. ASSUMPTION: gains and torque, chosen to
         follow the test's 2.0 rad/s steer_rate with the wheel loaded. -->
    <position name="steer_motor" joint="steer_joint" kp="400" ctrlrange="-1.3 1.3"
              forcerange="-80 80"/>
    <!-- Drive: a VELOCITY servo on the front wheel's roll, in rad/s. ctrlrange covers the test's
         max_wheel_speed (1.2 m/s) over r = 0.09. ASSUMPTION: gain and torque. -->
    <velocity name="front_wheel_motor" joint="front_wheel_joint" kv="30" ctrlrange="-14 14"
              forcerange="-40 40"/>
  </actuator>

  <keyframe>
    <!-- base_link on the floor, spawned a hair high so the tyres settle onto it. qpos in tree
         order: the free joint (7), rear_left_wheel_joint, rear_right_wheel_joint, steer_joint,
         front_wheel_joint. -->
    <key name="home" qpos="0 0 0.002 1 0 0 0  0 0 0 0"/>
  </keyframe>
</mujoco>
