<!-- A passage 0.75 m wide between a wall and a bench (0.75 m high): a load carried at about 0.95 m
     that is wider than the passage leaves passes only over the bench. carry_shelf_over_bench_shelf
     adds a shelf board at that height over the bench's far end. -->
<mujoco model="carry_shelf_over_bench">
  <worldbody>
    <geom name="floor" type="plane" size="6 6 0.05"/>
    <geom name="wall" type="box" pos="2 0.45 0.9" size="3 0.05 0.9"/>
    <geom name="wall_s" type="box" pos="2 -1.6 0.9" size="3 0.05 0.9"/>
    <geom name="bench" type="box" pos="2 -0.70 0.375" size="1.2 0.35 0.375"/>
  </worldbody>
</mujoco>
