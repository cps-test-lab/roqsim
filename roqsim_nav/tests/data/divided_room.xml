    <geom name="wall_s" type="box" pos="0 -4 1" size="4 .1 1"/>
    <geom name="wall_e" type="box" pos=" 4 0 1" size=".1 4 1"/>
    <geom name="wall_w" type="box" pos="-4 0 1" size=".1 4 1"/>
