<mujoco model="open_manipulator_x">
  <!-- ROBOTIS OpenMANIPULATOR-X (4-joint serial arm + parallel gripper) for MuJoCo. -->
  <compiler angle="radian" meshdir="meshes" autolimits="true"/>

  <!-- GENERATED by external/convert/build_open_manipulator_x_mjcf.py from
       /opt/ros/jazzy/share/open_manipulator_description/urdf/open_manipulator_x/open_manipulator_x.urdf
       Do not hand-edit: re-run the generator. Every link offset, mass and inertia
       tensor below is the vendor's own URDF value.

       No <option> here: timestep, integrator, solver and contact overrides belong to
       the EXPERIMENT (the world YAML's `sim:` block), not to the arm. -->

  <default>
    <default class="open_manipulator_x">
      <material specular="0.3" shininess="0.2"/>
      <!-- armature is the ONE joint property with no vendor value: the XM430's rotor
           inertia reflected through its 353:1 gearbox. 0.01 kg-m^2 is the standard
           Menagerie order for a geared hobby servo; damping comes from the URDF. -->
      <joint axis="0 1 0" armature="0.01"/>
      <!-- Position servo. Gains are a substrate calibration (port log S1), not a
           vendor number; forcerange is the XM430-W350's 4.1 N-m stall torque. -->
      <general gaintype="fixed" biastype="affine" gainprm="150"
               biasprm="0 -150 -10" forcerange="-4.1 4.1"/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" material="omx_grey"/>
      </default>
      <default class="collision">
        <!-- MuJoCo collides the mesh's convex hull. For a 380 mm arm against tree
             fronds that is the right fidelity, and it is the same shape MoveIt's FCL
             checker sees from the URDF, so sim and planner agree on the robot. -->
        <geom type="mesh" group="3" contype="1" conaffinity="1"/>
      </default>
      <site size="0.002" rgba="0.9 0.3 0.3 0.4" group="4"/>
    </default>
  </default>

  <asset>
    <material class="open_manipulator_x" name="omx_grey" rgba="0.25 0.25 0.25 1"/>
    <mesh file="gripper_left_palm.stl" scale="0.001 0.001 0.001"/>
    <mesh file="gripper_right_palm.stl" scale="0.001 0.001 0.001"/>
    <mesh file="link1.stl" scale="0.001 0.001 0.001"/>
    <mesh file="link2.stl" scale="0.001 0.001 0.001"/>
    <mesh file="link3.stl" scale="0.001 0.001 0.001"/>
    <mesh file="link4.stl" scale="0.001 0.001 0.001"/>
    <mesh file="link5.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <worldbody>
    <body name="link1" childclass="open_manipulator_x">
      <inertial pos="0.00030876154 0 -0.00012176461" mass="0.079119962" fullinertia="1.2505234e-05 2.1898364e-05 1.9267361e-05 0 -1.7855208e-07 0"/>
      <geom name="link1_vis" mesh="link1" pos="0 0 0" class="visual"/>
      <geom name="link1_col" mesh="link1" pos="0 0 0" class="collision"/>
      <body name="link2" pos="0.012 0 0">
        <inertial pos="-0.0003018487 0.00054043684 0.047433464" mass="0.098406837" fullinertia="3.4543422e-05 3.2689329e-05 1.885032e-05 -1.6031095e-08 -3.8375155e-07 2.8511935e-08"/>
        <joint name="joint1" axis="0 0 1" range="-3.14159265 3.14159265" damping="0.1"/>
        <geom name="link2_vis" mesh="link2" pos="0 0 0.019" class="visual"/>
        <geom name="link2_col" mesh="link2" pos="0 0 0.019" class="collision"/>
        <body name="link3" pos="0 0 0.0595">
          <inertial pos="0.010308393 0.00037743363 0.10170197" mass="0.13850917" fullinertia="0.00033055381 0.00034290447 6.0346498e-05 -9.7940978e-08 -3.8505711e-05 -1.5717516e-06"/>
          <joint name="joint2" axis="0 1 0" range="-1.5 1.5" damping="0.1"/>
          <geom name="link3_vis" mesh="link3" pos="0 0 0" class="visual"/>
          <geom name="link3_col" mesh="link3" pos="0 0 0" class="collision"/>
          <body name="link4" pos="0.024 0 0.128">
            <inertial pos="0.09090959 0.00038929816 0.00022413279" mass="0.13274562" fullinertia="3.0654178e-05 0.00024230292 0.00025155057 -1.2764155e-06 -2.6874417e-07 1.155955e-08"/>
            <joint name="joint3" axis="0 1 0" range="-1.5 1.4" damping="0.1"/>
            <geom name="link4_vis" mesh="link4" pos="0 0 0" class="visual"/>
            <geom name="link4_col" mesh="link4" pos="0 0 0" class="collision"/>
            <body name="link5" pos="0.124 0 0">
              <inertial pos="0.044206755 3.6839985e-07 0.0089142216" mass="0.14327573" fullinertia="8.0870749e-05 7.5980465e-05 9.3127351e-05 0 -1.0157896e-06 0"/>
              <joint name="joint4" axis="0 1 0" range="-1.7 1.97" damping="0.1"/>
              <geom name="link5_vis" mesh="link5" pos="0 0 0" class="visual"/>
              <geom name="link5_col" mesh="link5" pos="0 0 0" class="collision"/>
              <site name="attachment_site" pos="0.126 0 0"/>
              <site name="end_effector_site" pos="0.126 0 0"/>

              <!-- Eye-in-hand RealSense D435i. MuJoCo cameras look down -z with +y up, so
                   xyaxes below points the optical axis along link5's +x (the tool direction)
                   and leaves the image upright -- the pose realsense_d435's docstring gives.
                   fovy is the D435 depth stream's 58 deg vertical FOV. -->
              <camera name="d435_color" pos="0.07 0.032 0.052" xyaxes="0 -1 0 0 0 1" fovy="58" resolution="640 480"/>
              <site name="d435_mount" pos="0.07 0.032 0.052"/>

              <!-- Gripper fingers, WELDED at their URDF-zero pose (no joint, no actuator).
                   The paper this arm was ported for states the gripper is out of scope, and a
                   zero-pose weld makes the sim's finger geometry identical to what MoveIt
                   plans against from the same URDF at joint value 0. -->
              <geom name="gripper_left_link_vis" mesh="gripper_left_palm" pos="0.0817 0.021 0" class="visual"/>
              <geom name="gripper_left_link_col" mesh="gripper_left_palm" pos="0.0817 0.021 0" class="collision"/>
              <geom name="gripper_right_link_vis" mesh="gripper_right_palm" pos="0.0817 -0.021 0" class="visual"/>
              <geom name="gripper_right_link_col" mesh="gripper_right_palm" pos="0.0817 -0.021 0" class="collision"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <!-- Generated from open_manipulator_x.srdf's `disable_collisions`, so the simulated arm and
         the planned arm agree on which self-collisions are real. MuJoCo does not
         filter chain neighbours, and these meshes overlap ~21 mm at every joint --
         without this, link1-vs-link2 contact jams joint1 solid. -->
    <exclude body1="link1" body2="link2"/>
    <exclude body1="link1" body2="link3"/>
    <exclude body1="link2" body2="link3"/>
    <exclude body1="link3" body2="link4"/>
    <exclude body1="link4" body2="link5"/>
  </contact>

  <actuator>
    <general name="joint1" joint="joint1" ctrlrange="-3.14159265 3.14159265" class="open_manipulator_x"/>
    <general name="joint2" joint="joint2" ctrlrange="-1.5 1.5" class="open_manipulator_x"/>
    <general name="joint3" joint="joint3" ctrlrange="-1.5 1.4" class="open_manipulator_x"/>
    <general name="joint4" joint="joint4" ctrlrange="-1.7 1.97" class="open_manipulator_x"/>
  </actuator>
</mujoco>
