            <body name="link_4" pos="0 -0.559 0" quat="0.7070348 0.7071788 0 0">
              <inertial pos="7.1e-05    0.091879    -0.18252" mass="3.82" fullinertia="0.19063 0.17268 0.030386 -1.8037e-05 -3.8576e-05 -0.052996"/>
