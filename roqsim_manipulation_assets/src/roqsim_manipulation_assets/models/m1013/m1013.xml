                  <inertial pos="-0.000292       7e-06     -0.0539" mass="1.16" fullinertia="0.0048282 0.0059519 0.0061263 4.1298e-06 6.9879e-06 4.252e-06"/>
                  <joint name="joint_6" class="weak" range="-6.2832 6.2832"/>
                  <geom class="visual" mesh="MF1013_6_0" material="mat_MF1013_6_0"/>
