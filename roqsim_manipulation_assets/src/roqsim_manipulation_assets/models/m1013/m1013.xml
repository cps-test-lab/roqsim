        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <!-- Chain neighbours. MuJoCo's filterparent does not fire here: it is skipped when the parent is
         the world body, and base_link is welded to world, so every parent/child pair in this chain
         is measured. Adjacent links of a real arm cannot collide -- they are mechanically
         constrained -- and leaving these in puts self-collision at 100% of sampled configurations. -->
    <exclude body1="base_link" body2="link_1"/>
    <exclude body1="link_1" body2="link_2"/>
    <exclude body1="link_2" body2="link_3"/>
    <exclude body1="link_3" body2="link_4"/>
    <exclude body1="link_4" body2="link_5"/>
    <exclude body1="link_5" body2="link_6"/>
  </contact>

  <actuator>
    <position class="strong" name="joint_1" joint="joint_1" ctrlrange="-6.2832 6.2832" forcerange="-346 346"/>
    <position class="strong" name="joint_2" joint="joint_2" ctrlrange="-6.2832 6.2832" forcerange="-346 346"/>
    <position class="medium" name="joint_3" joint="joint_3" ctrlrange="-2.7925 2.7925" forcerange="-163 163"/>
    <position class="weak" name="joint_4" joint="joint_4" ctrlrange="-6.2832 6.2832" forcerange="-50 50"/>
    <position class="weak" name="joint_5" joint="joint_5" ctrlrange="-6.2832 6.2832" forcerange="-50 50"/>
    <position class="weak" name="joint_6" joint="joint_6" ctrlrange="-6.2832 6.2832" forcerange="-50 50"/>
  </actuator>

  <keyframe>
    <!-- Elbow-up over the workspace, the stance Doosan's own examples start from. -->
    <key name="home" qpos="0 0 1.5708 0 1.5708 0" ctrl="0 0 1.5708 0 1.5708 0"/>
  </keyframe>
</mujoco>
