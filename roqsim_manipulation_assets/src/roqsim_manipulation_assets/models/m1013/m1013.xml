              <body name="link_5" pos="0 0 0" quat="0.7070348 -0.7071788 0 0">
                <inertial pos="-0.000273    0.003651    0.032088" mass="2.82" fullinertia="0.015583 0.011519 0.0088671 2.135e-05 -5.1895e-06 0.00042553"/>
                <joint name="joint_5" class="weak" range="-6.2832 6.2832"/>
