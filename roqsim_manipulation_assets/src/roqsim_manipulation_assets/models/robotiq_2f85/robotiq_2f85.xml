<mujoco model="robotiq_2f85">
  <!-- Robotiq 2F-85 parallel gripper, standalone and attachable to ANY arm flange.

       Factored out of gen3.xml, which welded this same subtree inline. Both now describe one gripper
       in one place: gen3 keeps its inline copy for the Kinova it ships as an assembled unit, and this
       file is what `spawn_arm`'s `end_effector:` welds onto an arm that ships bare -- a UR10e/UR5e,
       whose MJCF ends at a tool flange. Ported from MuJoCo Menagerie's robotiq_2f85 (see
       ROBOTIQ_2F85_LICENSE, BSD-3, ROS-Industrial).

       FRAME CONVENTION (what makes it attachable): the root body `base_mount` sits at the origin with
       the fingers extending along +z, which is the tool-flange convention MuJoCo Menagerie uses for
       arm `attachment_site`s. So welding this model at an arm's `attachment_site` needs no rotation --
       gen3.xml's inline copy needs `quat="0 1 0 0"` only because it hangs off the bracelet's -z.

       JOINT NAMES ARE THE URDF'S, not Menagerie's. `robotiq_85_left_knuckle_joint` is the name in
       ros-jazzy-robotiq-description (robotiq_2f_85_macro.urdf.xacro), so the joint MoveIt plans and
       the joint MuJoCo simulates carry one name. Menagerie calls it `left_driver_joint`; gen3.xml had
       already renamed it, and that choice is kept here rather than reverted.

       The gripper is driven as ONE degree of freedom through a tendon, not through its joints:
       `fingers_actuator` (ctrlrange 0..255, 0 open) pulls the `split` tendon, which sums the two
       driver joints. That is what makes it a gripper to `arm_controller`: a non-joint transmission
       lands in `aux_acts` (see _arm.py `prefixed_actuators`) and is exposed as a GripperCommand
       action rather than as two more arm joints. The four-bar linkage per side is closed by the
       `equality/connect` pairs, and the left/right drivers are coupled by `equality/joint`.

       No <option>: a child spec's physics options are dropped on attach, so cone/impratio come from
       the world. `noslip_iterations` matters for holding an object -- see roqsim_mobile_manipulation's
       worlds and the humanoid pick FINDINGS.md.
       No <keyframe>: the pose is owned by spawn_arm/arm_controller, never baked. -->
  <compiler angle="radian" meshdir="meshes" autolimits="true"/>

  <default>
    <!-- Class names are gripper-specific (`g_*`, as in gen3.xml) rather than the generic
         `visual`/`collision`: this model is attached INTO an arm's spec, and with an empty
         end-effector prefix a class called `visual` would collide with the arm's own. -->
    <default class="2f85">
      <mesh scale="0.001 0.001 0.001"/>
      <general biastype="affine"/>
      <joint axis="1 0 0"/>
      <default class="driver">
        <joint range="0 0.8" armature="0.005" damping="0.1" solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
      </default>
      <default class="follower">
        <joint range="-0.872664 0.872664" armature="0.001" pos="0 -0.018 0.0065" solimplimit="0.95 0.99 0.001"
          solreflimit="0.005 1"/>
      </default>
      <default class="spring_link">
        <joint range="-0.29670597283 0.8" armature="0.001" stiffness="0.05" springref="2.62" damping="0.00125"/>
      </default>
      <default class="coupler">
        <joint range="-1.57 0" armature="0.001" solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
      </default>
      <default class="g_visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="g_collision">
        <geom type="mesh" group="3"/>
        <!-- The pads are boxes, not the pad mesh: MuJoCo collides a mesh by its convex hull, and a
             hull's face normals near an edge are what squirt a pinched box out of the jaws. Friction
             and solimp/solref are Menagerie's. -->
        <default class="pad_box1">
          <geom mass="0" type="box" pos="0 -0.0026 0.028125" size="0.011 0.004 0.009375" friction="0.7"
            solimp="0.95 0.99 0.001" solref="0.004 1" priority="1" rgba="0.55 0.55 0.55 1"/>
        </default>
        <default class="pad_box2">
          <geom mass="0" type="box" pos="0 -0.0026 0.009375" size="0.011 0.004 0.009375" friction="0.6"
            solimp="0.95 0.99 0.001" solref="0.004 1" priority="1" rgba="0.45 0.45 0.45 1"/>
        </default>
      </default>
    </default>
  </default>

  <asset>
    <!-- Millimetres, scaled to metres by class 2f85. Shared with gen3.xml's inline copy. -->
    <material name="2f85_gray" rgba="0.4627 0.4627 0.4627 1"/>
    <material name="2f85_black" rgba="0.149 0.149 0.149 1"/>
    <mesh class="2f85" file="base_mount.stl"/>
    <mesh class="2f85" file="base.stl"/>
    <mesh class="2f85" file="driver.stl"/>
    <mesh class="2f85" file="coupler.stl"/>
    <mesh class="2f85" file="follower.stl"/>
    <mesh class="2f85" file="pad.stl"/>
    <mesh class="2f85" file="silicone_pad.stl"/>
    <mesh class="2f85" file="spring_link.stl"/>
  </asset>

  <worldbody>
    <body name="base_mount" childclass="2f85">
      <geom class="g_visual" mesh="base_mount" material="2f85_black"/>
      <geom class="g_collision" mesh="base_mount"/>
      <body name="robotiq_85_base_link" pos="0 0 0.0038" quat="1 0 0 -1">
        <inertial mass="0.777441" pos="0 -2.70394e-05 0.0354675" quat="1 -0.00152849 0 0"
          diaginertia="0.000260285 0.000225381 0.000152708"/>
        <geom class="g_visual" mesh="base" material="2f85_black"/>
        <geom class="g_collision" mesh="base"/>
        <!-- Grasp centre, 0.145 m out along the approach axis. The pick driver reaches this site's
             pose, so a world/driver never hardcodes a finger offset. -->
        <site name="pinch" pos="0 0 0.145" type="sphere" group="5" rgba="0.9 0.9 0.9 1" size="0.005"/>
        <!-- Right-hand side 4-bar linkage -->
        <body name="right_driver" pos="0 0.0306011 0.054904">
          <inertial mass="0.00899563" pos="2.96931e-12 0.0177547 0.00107314"
            quat="0.681301 0.732003 0 0" diaginertia="1.72352e-06 1.60906e-06 3.22006e-07"/>
          <joint name="right_driver_joint" class="driver"/>
          <geom class="g_visual" mesh="driver" material="2f85_gray"/>
          <geom class="g_collision" mesh="driver"/>
          <body name="right_coupler" pos="0 0.0315 -0.0041">
            <inertial mass="0.0140974" pos="0 0.00301209 0.0232175"
              quat="0.705636 -0.0455904 0.0455904 0.705636"
              diaginertia="4.16206e-06 3.52216e-06 8.88131e-07"/>
            <joint name="right_coupler_joint" class="coupler"/>
            <geom class="g_visual" mesh="coupler" material="2f85_black"/>
            <geom class="g_collision" mesh="coupler"/>
          </body>
        </body>
        <body name="right_spring_link" pos="0 0.0132 0.0609">
          <inertial mass="0.0221642" pos="-8.65005e-09 0.0181624 0.0212658"
            quat="0.663403 -0.244737 0.244737 0.663403"
            diaginertia="8.96853e-06 6.71733e-06 2.63931e-06"/>
          <joint name="right_spring_link_joint" class="spring_link"/>
          <geom class="g_visual" mesh="spring_link" material="2f85_black"/>
          <geom class="g_collision" mesh="spring_link"/>
          <body name="right_follower" pos="0 0.055 0.0375">
            <inertial mass="0.0125222" pos="0 -0.011046 0.0124786" quat="1 0.1664 0 0"
              diaginertia="2.67415e-06 2.4559e-06 6.02031e-07"/>
            <joint name="right_follower_joint" class="follower"/>
            <geom class="g_visual" mesh="follower" material="2f85_black"/>
            <geom class="g_collision" mesh="follower"/>
            <body name="right_pad" pos="0 -0.0189 0.01352">
              <geom class="pad_box1" name="right_pad1"/>
              <geom class="pad_box2" name="right_pad2"/>
              <inertial mass="0.0035" pos="0 -0.0025 0.0185" quat="0.707107 0 0 0.707107"
                diaginertia="4.73958e-07 3.64583e-07 1.23958e-07"/>
              <geom class="g_visual" mesh="pad"/>
              <body name="right_silicone_pad">
                <geom class="g_visual" mesh="silicone_pad" material="2f85_black"/>
              </body>
            </body>
          </body>
        </body>
        <!-- Left-hand side 4-bar linkage -->
        <body name="left_driver" pos="0 -0.0306011 0.054904" quat="0 0 0 1">
          <inertial mass="0.00899563" pos="0 0.0177547 0.00107314" quat="0.681301 0.732003 0 0"
            diaginertia="1.72352e-06 1.60906e-06 3.22006e-07"/>
          <joint name="robotiq_85_left_knuckle_joint" class="driver"/>
          <geom class="g_visual" mesh="driver" material="2f85_gray"/>
          <geom class="g_collision" mesh="driver"/>
          <body name="left_coupler" pos="0 0.0315 -0.0041">
            <inertial mass="0.0140974" pos="0 0.00301209 0.0232175"
              quat="0.705636 -0.0455904 0.0455904 0.705636"
              diaginertia="4.16206e-06 3.52216e-06 8.88131e-07"/>
            <joint name="left_coupler_joint" class="coupler"/>
            <geom class="g_visual" mesh="coupler" material="2f85_black"/>
            <geom class="g_collision" mesh="coupler"/>
          </body>
        </body>
        <body name="left_spring_link" pos="0 -0.0132 0.0609" quat="0 0 0 1">
          <inertial mass="0.0221642" pos="-8.65005e-09 0.0181624 0.0212658"
            quat="0.663403 -0.244737 0.244737 0.663403"
            diaginertia="8.96853e-06 6.71733e-06 2.63931e-06"/>
          <joint name="left_spring_link_joint" class="spring_link"/>
          <geom class="g_visual" mesh="spring_link" material="2f85_black"/>
          <geom class="g_collision" mesh="spring_link"/>
          <body name="left_follower" pos="0 0.055 0.0375">
            <inertial mass="0.0125222" pos="0 -0.011046 0.0124786" quat="1 0.1664 0 0"
              diaginertia="2.67415e-06 2.4559e-06 6.02031e-07"/>
            <joint name="left_follower_joint" class="follower"/>
            <geom class="g_visual" mesh="follower" material="2f85_black"/>
            <geom class="g_collision" mesh="follower"/>
            <body name="left_pad" pos="0 -0.0189 0.01352">
              <geom class="pad_box1" name="left_pad1"/>
              <geom class="pad_box2" name="left_pad2"/>
              <inertial mass="0.0035" pos="0 -0.0025 0.0185" quat="1 0 0 1"
                diaginertia="4.73958e-07 3.64583e-07 1.23958e-07"/>
              <geom class="g_visual" mesh="pad"/>
              <body name="left_silicone_pad">
                <geom class="g_visual" mesh="silicone_pad" material="2f85_black"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="robotiq_85_base_link" body2="left_driver"/>
    <exclude body1="robotiq_85_base_link" body2="right_driver"/>
    <exclude body1="robotiq_85_base_link" body2="left_spring_link"/>
    <exclude body1="robotiq_85_base_link" body2="right_spring_link"/>
    <exclude body1="right_coupler" body2="right_follower"/>
    <exclude body1="left_coupler" body2="left_follower"/>
  </contact>

  <tendon>
    <!-- Distribute force between the two driver joints (see robotiq_2f85). -->
    <fixed name="split">
      <joint joint="right_driver_joint" coef="0.5"/>
      <joint joint="robotiq_85_left_knuckle_joint" coef="0.5"/>
    </fixed>
  </tendon>

  <equality>
    <connect anchor="0 0 0" body1="right_follower" body2="right_coupler" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <connect anchor="0 0 0" body1="left_follower" body2="left_coupler" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <joint joint1="right_driver_joint" joint2="robotiq_85_left_knuckle_joint" polycoef="0 1 0 0 0" solimp="0.95 0.99 0.001"
      solref="0.005 1"/>
  </equality>

  <actuator>
    <!-- The gripper's single DOF: ctrl 0 (open) .. 255 (closed). arm_controller maps a commanded
         gripper_joint angle onto this range and serves it as a GripperCommand action. -->
    <general class="2f85" name="fingers_actuator" tendon="split" forcerange="-5 5" ctrlrange="0 255"
      gainprm="0.3137255 0 0" biasprm="0 -100 -10"/>
  </actuator>
</mujoco>
