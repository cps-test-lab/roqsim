<mujoco model="realsense_d455">
  <!--
    Intel RealSense D455: visual mesh + a colour camera, mounted by `spawn_sensor` at the
    vendor joint origin of `<name>_link`. Written by external/convert/build_realsense_devices.py from
    realsense2_description/urdf/_d455.urdf.xacro @ realsense-ros 53169f3 (tag 4.56.1);
    see REALSENSE_D455_MESH_LICENSE.

    The `mount` body IS `camera_link`: x forward (the lens normal), y left, z up. The mesh keeps
    its own axes and carries the vendor mesh-in-link origin as its pose; the front plate and the
    collision box were measured on the converted mesh and ride the same pose. `d455_color` is
    the vendor `camera_color_optical_frame`, turned into MuJoCo's camera convention (looks down -z,
    +y up). The manifest's `frames:` publishes the vendor chain from this body.
  -->
  <compiler angle="radian" meshdir="meshes" autolimits="true"/>

  <asset>
    <mesh name="d455_mesh" file="d455.obj"/>
    <material name="d455_body" rgba="0.75 0.75 0.77 1" specular="0.4" shininess="0.3"/>
    <material name="d455_glass" rgba="0.05 0.05 0.05 1" specular="0.6" shininess="0.6"/>
  </asset>

  <worldbody>
    <body name="mount">
      <geom name="d455_visual" type="mesh" mesh="d455_mesh" material="d455_body"
            pos="0.00465 -0.0475 0" quat="0.5 0.5 0.5 0.5" contype="0" conaffinity="0"/>
      <!-- Front glass strip: the decimated mesh has no separate material for the front window, so
           a thin black plate stands in, just proud of the mesh's front face. -->
      <geom name="d455_front" type="box" pos="0.00495 -0.0475 0" quat="0.5 0.5 0.5 0.5"
            size="0.055 0.0105 0.0004" material="d455_glass" contype="0" conaffinity="0"/>
      <geom name="d455_collision" type="box" pos="-0.00845 -0.0475 0" quat="0.5 0.5 0.5 0.5"
            size="0.062 0.0145 0.013" group="3"/>
      <camera name="d455_color" pos="0 -0.059 0" xyaxes="0 -1 0 0 0 1"
              fovy="62" resolution="640 400"/>
    </body>
  </worldbody>
</mujoco>
