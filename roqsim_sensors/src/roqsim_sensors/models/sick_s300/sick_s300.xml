<mujoco model="sick_s300">
  <!--
    SICK S300 safety laser scanner: a standalone mount (housing mesh + a `scan` site) for the
    `spawn_sensor` plugin, mounted by a robot manifest at its vendor joint origin.

    Geometry from Neobotix `neo_simulation2`, whose MP-400 and MPO-700 carry this scanner: the body is
    `lidar_1_link` (mpo_700_body.urdf.xacro), the mesh keeps that link's visual origin
    xyz (0, 0, -0.12), rpy (-1.57, 0, 3.14), and the scan is stamped in the link itself.

    Body-local axes: x = the scan's zero bearing, z = up with the device upright. The datasheet puts
    the scan plane 116 mm above the housing bottom, which is z = -0.004 here; the site stays on the
    vendor frame.

    Built by external/convert/build_scanner_devices.py from neo_simulation2 @ 832041452c1a0199afea1e9b65adf37381e96214.
    Scan parameters and the `frames:` entry for this site are in sick_s300.manifest.yaml; see
    sick_s300_LICENSE for the mesh licence.
  -->
  <compiler angle="radian" meshdir="meshes" autolimits="true"/>

  <asset>
    <material name="SICK-S300__m0_mat" rgba="0.251 0.251 0.251 1"/>
    <material name="SICK-S300__m1_mat" rgba="0.9569 0.9569 0.9569 1"/>
    <material name="SICK-S300__m2_mat" rgba="0.5451 0.549 0.549 1"/>
    <material name="SICK-S300__m3_mat" rgba="0 0 0 1"/>
    <material name="SICK-S300__m4_mat" rgba="0.8667 0.8667 0.051 1"/>
    <material name="SICK-S300__m5_mat" rgba="1 1 0 1"/>
    <material name="SICK-S300__m6_mat" rgba="0.749 0.749 0.749 1"/>
    <mesh name="SICK-S300__m0" file="SICK-S300__m0.obj"/>
    <mesh name="SICK-S300__m1" file="SICK-S300__m1.obj"/>
    <mesh name="SICK-S300__m2" file="SICK-S300__m2.obj"/>
    <mesh name="SICK-S300__m3" file="SICK-S300__m3.obj"/>
    <mesh name="SICK-S300__m4" file="SICK-S300__m4.obj"/>
    <mesh name="SICK-S300__m5" file="SICK-S300__m5.obj"/>
    <mesh name="SICK-S300__m6" file="SICK-S300__m6.obj"/>
  </asset>

  <worldbody>
    <body name="mount">
      <inertial pos="0 0 0" mass="1.2" diaginertia="0.11042056 0.11042056 0.11042056"/>
      <geom name="sick_s300_visual_0" type="mesh" mesh="SICK-S300__m0" material="SICK-S300__m0_mat" pos="0 0 -0.12" quat="0.000563312 -0.000562864 -0.706824957 0.707388045"
            contype="0" conaffinity="0"/>
      <geom name="sick_s300_visual_1" type="mesh" mesh="SICK-S300__m1" material="SICK-S300__m1_mat" pos="0 0 -0.12" quat="0.000563312 -0.000562864 -0.706824957 0.707388045"
            contype="0" conaffinity="0"/>
      <geom name="sick_s300_visual_2" type="mesh" mesh="SICK-S300__m2" material="SICK-S300__m2_mat" pos="0 0 -0.12" quat="0.000563312 -0.000562864 -0.706824957 0.707388045"
            contype="0" conaffinity="0"/>
      <geom name="sick_s300_visual_3" type="mesh" mesh="SICK-S300__m3" material="SICK-S300__m3_mat" pos="0 0 -0.12" quat="0.000563312 -0.000562864 -0.706824957 0.707388045"
            contype="0" conaffinity="0"/>
      <geom name="sick_s300_visual_4" type="mesh" mesh="SICK-S300__m4" material="SICK-S300__m4_mat" pos="0 0 -0.12" quat="0.000563312 -0.000562864 -0.706824957 0.707388045"
            contype="0" conaffinity="0"/>
      <geom name="sick_s300_visual_5" type="mesh" mesh="SICK-S300__m5" material="SICK-S300__m5_mat" pos="0 0 -0.12" quat="0.000563312 -0.000562864 -0.706824957 0.707388045"
            contype="0" conaffinity="0"/>
      <geom name="sick_s300_visual_6" type="mesh" mesh="SICK-S300__m6" material="SICK-S300__m6_mat" pos="0 0 -0.12" quat="0.000563312 -0.000562864 -0.706824957 0.707388045"
            contype="0" conaffinity="0"/>
      <!-- The vendor collides with the full mesh; this box bounds the converted housing instead. -->
      <geom name="sick_s300_collision" type="box" pos="-0.0021 0.0001 -0.04385" size="0.053 0.0512 0.07625" group="3"/>
      <!-- The vendor scan frame (lidar_1_link) is the mount itself.
           Keep in step with the manifest's `frames:` entry. -->
      <site name="scan" pos="0 0 0" size="0.005"/>
    </body>
  </worldbody>
</mujoco>
