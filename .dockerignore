# Keep the Docker build context small and stable so `docker compose build` hits the layer cache and
# only rebuilds when the copied package sources actually change. Without this, transient files inside
# the COPY'd package dirs (pycache, egg-info, pytest cache) change the layer hash on every local test
# run and force a full pip + colcon rebuild.

# Version control
.git/
.gitignore

# Python virtualenv + caches (huge; never needed in the image)
.venv/
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.pytest_cache/
.ruff_cache/

# Build / docs / log output
build/
log/
MUJOCO_LOG.TXT

# colcon artifacts (the image builds these fresh)
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# Not needed to build the sim image
docs/
.github/
.vscode/
.idea/
**/.DS_Store
